# =============================================================================
# Bookey Backend Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All settings have safe defaults for development; production requires changes.

# --- App Environment ---
# Options: development, testing, production
APP_ENV=development
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# SQLite for development (default), PostgreSQL for production
# Examples:
#   Development: sqlite+aiosqlite:///./bookey_dev.db
#   Production: postgresql+asyncpg://user:pass@host:5432/bookey
DATABASE_URL=sqlite+aiosqlite:///./bookey_dev.db
DB_ECHO=false

# --- Auth & Security ---
# CRITICAL: Set a strong random SECRET_KEY in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development admin password (only used if BOOKEY_ADMIN_DEV_PASSWORD is set)
# If not set in development, a random password will be generated and printed
# Production deployments must NOT use this and should never seed a default admin
BOOKEY_ADMIN_DEV_PASSWORD=

# --- CORS ---
# Comma-separated list of allowed origins
# MUST NOT contain localhost in production!
CORS_ORIGINS=http://localhost:3000,http://localhost:4100,http://127.0.0.1:3000

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30
WS_HEARTBEAT_TIMEOUT=10
WS_MAX_MESSAGE_SIZE=524288
WS_AUTH_TIMEOUT=5.0

# --- Protocol ---
BOOK_PROTOCOL_VERSION=2

# --- MockBookService Timing (milliseconds) ---
MOCK_TOKEN_MS=85
MOCK_THINKING_MS=600
MOCK_ANSWER_TOKEN_MS=45
MOCK_CODE_STREAM_MS=30

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- SMTP (Email) ---
# Required for password reset in production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@bookey.app

# =============================================================================
# B2: Knowledge Base
# =============================================================================

# --- Document Processing ---
MAX_DOCUMENT_SIZE_BYTES=26214400  # 25 MB

# --- Storage ---
# Options: local, s3
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./uploads

# S3-compatible storage (when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_ENDPOINT_URL=

# --- Embeddings ---
# Options: mock, bge-m3
EMBEDDING_BACKEND=mock
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto

# --- Vector Store ---
# Options: chroma, pgvector
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./chroma_db

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0
RETRIEVAL_MMR_LAMBDA=0.7

# =============================================================================
# B3: LLM Router & Page Generator
# =============================================================================

# --- LLM Providers ---
# Comma-separated list, tried in order: gemini,groq,openrouter,mock
LLM_PROVIDERS=gemini,groq,openrouter,mock
LLM_RETRY_PER_PROVIDER=2
LLM_BACKOFF_BASE_S=1.0

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# --- Page Generator ---
PAGE_MIN_WORDS=60
PAGE_MAX_WORDS=300
PAGE_MAX_TOKENS=8192
PAGE_GEN_MAX_REPAIR_ATTEMPTS=2

# =============================================================================
# B4: Tutor Agent
# =============================================================================

TUTOR_HISTORY_WINDOW=3
TUTOR_MAX_ANSWER_TOKENS=800

# =============================================================================
# B5: Voice (STT + TTS)
# =============================================================================

# --- Voice Providers ---
# Options: bodhan, gemini, edge, silent
TTS_PROVIDER=bodhan
# Options: local, groq
STT_PROVIDER=local

# --- Speech-to-Text ---
# Local Faster-Whisper (default in demo)
FASTER_WHISPER_MODEL=large-v3-turbo
# Groq Whisper (cloud alternative)
BOOKEY_STT_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Bodhan Indic-Speak Text-to-Speech ---
BODHAN_API_KEY=
BODHAN_TTS_MODEL=indic-speak
BODHAN_TTS_VOICE=Anitha
BODHAN_TTS_LANG=ta
BODHAN_TTS_STYLE="educational lecture"

# --- Gemini Text-to-Speech (alternative) ---
BOOKEY_TTS_MODEL=gemini-3.8-flash-tts
BOOKEY_TTS_VOICE=Puck
BOOKEY_TTS_STYLE="clear, warm, patient teaching style"
EDGE_TTS_VOICE=ta-IN-ValluvarNeural

# --- Audio Cache ---
AUDIO_CACHE_DIR=./backend/.cache/bookey-voice
VOICE_ENABLED=true
TTS_FIRST_SENTENCE_ONLY=true

